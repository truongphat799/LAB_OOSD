          <mxGeometry x="485" y="40" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="Tiếp nhận hồ sơ ứng viên tại phòng Nhân sự&#xa;và kiểm tra tính hợp lệ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="380" y="100" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="dec1" value="Loại nhân sự?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="435" y="170" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step_tai" value="Tra cứu lý lịch hồ sơ nhân sự trên hệ thống&#xa;(theo Mã NV, CCCD hoặc Họ tên)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="190" y="240" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="step_moi1" value="Điền phiếu thông tin nhân sự, nộp bằng cấp,&#xa;chứng chỉ chuyên môn và 02 ảnh chân dung 3x4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="570" y="240" width="250" height="45" as="geometry" />
        </mxCell>
        <mxCell id="step_moi2" value="Soạn thảo &amp; ký duyệt Quyết định tuyển dụng thử việc&#xa;(ghi rõ thời gian, phân xưởng, mức lương thử việc)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="565" y="310" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="485" y="380" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="Bàn giao nhân sự về đơn vị; Trưởng phòng/xưởng hướng dẫn,&#xa;giám sát an toàn hóa chất sơn và theo dõi thử việc" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="365" y="440" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dec2" value="Kết quả thử việc?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="425" y="520" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step_fail" value="Chấm dứt thử việc, quyết toán lương ngày công&#xa;&amp; thanh lý hồ sơ không trúng tuyển" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="670" y="520" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="end_fail" value="" style="ellipse;html=1;shape=endState;fillColor=#1A1A1A;" parent="1" vertex="1">
          <mxGeometry x="940" y="530" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="step_pass" value="Trưởng bộ phận lập bản đánh giá Đạt, gửi tờ trình&#xa;đề xuất ký Hợp đồng lao động chính thức về Nhân sự" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="365" y="600" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dec3" value="Loại hợp đồng?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="430" y="680" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step_dh" value="Soạn HĐLĐ dài hạn &amp; lập hồ sơ BHYT, BHXH&#xa;(đăng ký mã BHXH, cấu hình trích nộp 10.5% LCB)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="220" y="760" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step_nh" value="Soạn HĐLĐ ngắn hạn / thời vụ xưởng sơn&#xa;(không bắt buộc trích nộp bảo hiểm xã hội)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="540" y="760" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
