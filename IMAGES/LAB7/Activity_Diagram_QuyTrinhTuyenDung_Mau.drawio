        </mxCell>
        <mxCell id="step_sohoa" value="Phòng Nhân sự số hóa &amp; lưu trữ toàn bộ thông tin đợt tuyển dụng:&#xa;ngày vào làm, thử việc, HĐLĐ, BHYT/BHXH, chức vụ &amp; lương" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
