        </mxCell>
        <mxCell id="note2" value="Phục vụ theo dõi diễn biến công tác,&#xa;đánh giá năng suất, xét thi đua khen thưởng,&#xa;kỷ luật và phân định trách nhiệm quản lý" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fontSize=10;align=left;" parent="1" vertex="1">
