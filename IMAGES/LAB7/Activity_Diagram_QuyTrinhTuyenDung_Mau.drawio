        </mxCell>
        <mxCell id="step_qd" value="Nhân sự thiết lập dự thảo Quyết định chức vụ (PCCV)&#xa;&amp; Quyết định lương ban đầu (LCB, phụ cấp lương)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="365" y="940" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dec4" value="Vị trí tiếp xúc hóa chất dung môi sơn?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="385" y="1020" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="step_dochai" value="Cập nhật Phụ cấp độc hại sơn bắt buộc (1.2M - 2.0M)&#xa;vào Quyết định lương &amp; cấp phát bảo hộ lao động" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="190" y="1100" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="485" y="1170" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="step_sign" value="Giám đốc xem xét &amp; ký kết chính thức bộ 3 văn bản:&#xa;1. Hợp đồng lao động&#xa;2. Quyết định chức vụ&#xa;3. Quyết định lương" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="365" y="1230" width="270" height="65" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="Hồ sơ tự động đồng bộ sang&#xa;Ban chấm công &amp; Kế toán lương&#xa;để chuẩn bị xếp ca &amp; tính lương" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fontSize=10;align=left;" parent="1" vertex="1">
