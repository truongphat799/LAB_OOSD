  <diagram id="ActivityDiagram_Doc_Mau" name="Activity Diagram - Quy Trinh Tuyen Dung Thu Viec Den Ky Hop Dong">
    <mxGraphModel dx="1489" dy="894" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="2400" math="0" shadow="0">
