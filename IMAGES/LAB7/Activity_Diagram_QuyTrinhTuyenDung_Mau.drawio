        </mxCell>
        <mxCell id="step_kichhoat" value="Chuyển trạng thái nhân sự thành &#39;Chính thức&#39;,&#xa;bàn giao bản sao HĐLĐ cho người lao động" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="365" y="1320" width="270" height="45" as="geometry" />
        </mxCell>
        <mxCell id="step_dongbo" value="Ban chấm công xếp ca làm việc tuần; Kế toán lương&#xa;thiết lập danh mục chi trả &amp; tài khoản ATM ngân hàng" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" parent="1" vertex="1">
