        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam roundCorner 10\n\nactor \&quot;:TruongDonVi\&quot; as TP\nactor \&quot;:NhanVienNhanSu\&quot; as NS\nboundary \&quot;:FrmKhenThuongKyLuat\&quot; as UI\ncontrol \&quot;:KhenThuongController\&quot; as Ctrl\ncontrol \&quot;:KhenThuongService\&quot; as Service\nactor \&quot;:GiamDoc\&quot; as GD\nactor \&quot;:KeToanLuong\&quot; as KT\ndatabase \&quot;:SQLServer_DB\&quot; as DB\n\nTP -&gt; NS: guiToTrinhDeXuat(loai, maDoiTuong, lyDo, soTien)\nactivate NS\nNS -&gt; UI: moGiaoDienLapQDKhenThuong()\nactivate UI\n\nUI -&gt; Service: layDanhSachNhanVienVaPhongBan()\nactivate Service\nService -&gt; DB: SELECT MaNV, HoTen, MaPhongBan FROM NhanVien WHERE TrangThai = &#39;Chính thức&#39;\nactivate DB\nDB --&gt; Service: traVeDanhSachNhanSu()\ndeactivate DB\nService --&gt; UI: hienThiDanhSachDoiTuong()\ndeactivate Service\nUI --&gt; NS: hienThiFormNhapThongTin()\n\nNS -&gt; UI: nhapThongTinQDKhenThuong(loai, maDoiTuong, lyDo, soTien, hinhThucChi)\nUI -&gt; Ctrl: luuDuThaoQDKhenThuong(dto)\nactivate Ctrl\nCtrl -&gt; Service: xuLyLuuDuThao(dto)\nactivate Service\nService -&gt; DB: INSERT INTO QuyetDinhKhenThuong(SoQD, NgayBanHanh, TrangThai = N&#39;Chờ duyệt&#39;)\nactivate DB\nDB --&gt; Service: xacNhanLuuThanhCong(soQD)\ndeactivate DB\nService --&gt; Ctrl: traVeKetQua(soQD)\ndeactivate Service\nCtrl --&gt; UI: thongBaoChoGiamDocKyDuyet(soQD)\ndeactivate Ctrl\ndeactivate NS\n\nGD -&gt; UI: xemChiTietQDKhenThuong(soQD)\nGD -&gt; UI: kyDuyetBanHanhQuyetDinh(soQD, ngayKy)\nUI -&gt; Ctrl: capNhatTrangThaiBanHanh(soQD)\nactivate Ctrl\nCtrl -&gt; Service: banHanhQuyetDinh(soQD)\nactivate Service\nService -&gt; DB: UPDATE QuyetDinhKhenThuong SET TrangThai = N&#39;Đã ban hành&#39; WHERE SoQD = ?\nactivate DB\nDB --&gt; Service: xacNhanCapNhatThanhCong()\ndeactivate DB\nService --&gt; Ctrl: thongBaoBanHanhThanhCong()\ndeactivate Service\nCtrl --&gt; UI: hienThiThongBaoBanHanh()\ndeactivate Ctrl\nUI --&gt; KT: guiThongBaoSangPhanHeKeToan(soQD)\n\nalt Hình thức chi: Phiếu chi khen thưởng (Tiền mặt)\n    KT -&gt; UI: lapPhieuChiTienThuong(soQD, soTien, nguoiNhan)\n    UI -&gt; Ctrl: luuPhieuChi(soPhieuChi, soQD, soTien)\n    activate Ctrl\n    Ctrl -&gt; DB: INSERT INTO PhieuChiThuong(SoPhieuChi, SoQDKhenThuong, SoTienChi)\n    activate DB\n    DB --&gt; Ctrl: xacNhanLuuPhieuChi()\n    deactivate DB\n    Ctrl --&gt; UI: inPhieuChiVaXuatTienMat()\n    deactivate Ctrl\nelse Hình thức chi: Cộng vào bảng lương tháng\n    KT -&gt; UI: ketChuyenVaoBangLuongThang(soQD, thang, nam)\n    UI -&gt; Ctrl: capNhatTienThuongVaoBangLuong(soQD, thang, nam)\n    activate Ctrl\n    Ctrl -&gt; DB: UPDATE ChiTietBangLuong SET TienKhenThuong = TienKhenThuong + @soTien WHERE MaNV = @maNV\n    activate DB\n    DB --&gt; Ctrl: xacNhanKetChuyenThanhCong()\n    deactivate DB\n    Ctrl --&gt; UI: thongBaoDaCongVaoBangLuongThang()\n    deactivate Ctrl\nend\n\nUI --&gt; TP: inQuyetDinhVaLuuHoSo()\ndeactivate UI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KliOzu8rHUEVdh3a3vgi-1">
