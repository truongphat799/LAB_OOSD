        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml SD_LapPhieuGhiNo\nskinparam defaultFontName Arial\nskinparam defaultFontSize 11\nskinparam backgroundColor white\n\nactor \&quot;: NhanVien\&quot; as NV\nboundary \&quot;: FrmLapPhieuGhiNo\&quot; as Form\ncontrol \&quot;: CongNoService\&quot; as Service\nentity \&quot;: KhachHang\&quot; as KH\nentity \&quot;: PhieuGhiNo\&quot; as PGN\n\nNV -&gt; Form : moGiaoDienLapPhieuNo(maHoaDon)\nactivate Form\nForm --&gt; NV : hienThiFormLapPhieuNo()\n\nNV -&gt; Form : nhapThongTinPhieuNo(maKH, soTienNo, ngayDuKienTra, lyDoNo)\nNV -&gt; Form : nhan \&quot;Xac nhan lap phieu no\&quot;\nForm -&gt; Service : lapPhieuGhiNo(maHD, maKH, soTienNo, ngayDuKienTra, lyDoNo, maNV)\nactivate Service\n\nService -&gt; Service : kiemTraDinhDangDuLieu(soTienNo, ngayDuKienTra)\nService -&gt; KH : kiemTraThongTinKhach(maKH)\nactivate KH\nKH --&gt; Service : thongTinKhach(loaiKhach, tongNoHienTai)\ndeactivate KH\n\nalt [loaiKhach == \&quot;Khach quen\&quot; va ngayDuKienTra &gt; ngayHienTai va soTienNo &gt; 0]\n    Service -&gt; PGN : taoPhieuGhiNo(maPhieuNo, ngayLap, soTienNo, ngayDuKienTra, lyDoNo, maNV, maKH, maHD)\n    activate PGN\n    PGN --&gt; Service : phieuGhiNoMoi\n    deactivate PGN\n    Service -&gt; KH : capNhatTangCongNo(maKH, soTienNo)\n    activate KH\n    KH --&gt; Service : xacNhanCapNhat\n    deactivate KH\n    Service --&gt; Form : KetQua.Success(\&quot;Lập phiếu ghi nợ thành công\&quot;, phieuGhiNoMoi)\n    Form --&gt; NV : inPhieuGhiNoVaThongBao(\&quot;Lập phiếu nợ thành công\&quot;)\nelse [loaiKhach == \&quot;Khach vang lai\&quot;]\n    Service --&gt; Form : KetQua.Fail(\&quot;Khách vãng lai không được phép trả chậm!\&quot;)\n    Form --&gt; NV : thongBaoLoi(\&quot;Khách hàng không đủ điều kiện ghi nợ\&quot;)\nelse [ngayDuKienTra &lt;= ngayHienTai hoac soTienNo &lt;= 0]\n    Service --&gt; Form : KetQua.Fail(\&quot;Ngày hẹn trả hoặc số tiền nợ không hợp lệ!\&quot;)\n    Form --&gt; NV : thongBaoLoi(\&quot;Vui lòng kiểm tra lại ngày hẹn trả và số tiền nợ\&quot;)\nend\n\ndeactivate Service\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lCK9KONPfdLrcpDyGJTQ-1">
