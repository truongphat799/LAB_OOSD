        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam roundCorner 10\n\nactor \&quot;:BacSi\&quot; as BS\nboundary \&quot;:FrmLapToaThuoc\&quot; as UI\ncontrol \&quot;:ToaThuocController\&quot; as Ctrl\ncontrol \&quot;:HoSoBenhAnService\&quot; as HS\ncontrol \&quot;:ThuocRepository\&quot; as Repo\nentity \&quot;:ToaThuoc\&quot; as TT\ndatabase \&quot;:CSDL\&quot; as DB\n\nBS -&gt; UI: moGiaoDienKeToa(maPhieuKham, maHoSo)\nactivate UI\nUI -&gt; HS: layTienSuBenhVaDiUng(maHoSo)\nactivate HS\nHS -&gt; DB: SELECT tienSuBenh, tienSuDiUng FROM HoSoBenhAn WHERE maHoSo = ?\nactivate DB\nDB --&gt; HS: traVeThongTinTienSu(tienSuDiUng, phanUngPhuThuoc)\ndeactivate DB\nHS --&gt; UI: traVeDuLieuTienSuBenh()\ndeactivate HS\nUI --&gt; BS: hienThiThongTinBenhAnVaTienSu()\n\nBS -&gt; UI: timKiemThuoc(tuKhoa)\nUI -&gt; Repo: timKiemThuoc(tuKhoa)\nactivate Repo\nRepo -&gt; DB: SELECT * FROM Thuoc WHERE tenThuoc LIKE ? AND soLuongTon &gt; 0\nactivate DB\nDB --&gt; Repo: traVeDanhSachThuoc()\ndeactivate DB\nRepo --&gt; UI: hienThiGoiYDanhSachThuoc()\ndeactivate Repo\n\nBS -&gt; UI: themThuocVaoToa(maThuoc, soLuong, lieuDung, cachDung)\nUI -&gt; Ctrl: kiemTraAnToanDonThuoc(maHoSo, maThuoc)\nactivate Ctrl\nCtrl -&gt; HS: kiemTraDiUngVaPhanUngThuoc(maHoSo, maThuoc)\nactivate HS\n\nalt Phát hiện tiền sử dị ứng / Phản ứng phụ nguy hiểm\n    HS --&gt; Ctrl: traVeCanhBao(coPhanUngPhu = true, ghiChuDiUng)\n    Ctrl --&gt; UI: thongBaoCanhBaoDiUng(ghiChuDiUng)\n    UI --&gt; BS: hienThiPopUpCanhBaoVaDeXuatDoiThuoc()\nelse An toàn &amp; Hợp lệ\n    HS --&gt; Ctrl: xacNhanAnToan(hopLe = true)\n    deactivate HS\n    Ctrl --&gt; UI: xacNhanThemThuocThanhCong()\n    UI --&gt; BS: hienThiDongThuocTrenGrid()\nend\ndeactivate Ctrl\n\nBS -&gt; UI: xacNhanLuuToaThuoc(chanDoan, loiDanBS, ngayTaiKham)\nUI -&gt; Ctrl: luuToaThuoc(maPhieuKham, dsChiTiet, chanDoan, loiDan)\nactivate Ctrl\nCtrl -&gt; TT: create(maToa, maPhieuKham, ngayKe, chanDoan)\nactivate TT\n\nloop Mỗi thuốc trong danh sách đã kê\n    Ctrl -&gt; TT: taoChiTietToa(maChiTiet, maThuoc, soLuong, lieuDung)\nend\ndeactivate TT\n\nCtrl -&gt; DB: INSERT INTO ToaThuoc, ChiTietToaThuoc\nactivate DB\nCtrl -&gt; Repo: capNhatGiamSoLuongTonKho(dsThuoc)\nDB --&gt; Ctrl: xacNhanLuuThanhCong(maToaThuoc)\ndeactivate DB\nCtrl --&gt; UI: thongBaoLuuToaThanhCong()\ndeactivate Ctrl\nUI --&gt; BS: inToaThuocGiayVaDongBoNhaThuoc()\ndeactivate UI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hEIZgaXdvgHIbUctmtDI-1">
