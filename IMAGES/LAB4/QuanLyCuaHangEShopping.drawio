  <diagram id="yVNbDkEnkYN_T0lwJow7" name="class_phantich">
    <mxGraphModel dx="1042" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam shadowing false\n\n&#39; Định dạng màu vàng viền đỏ đô kinh điển\nskinparam class {\n    BackgroundColor #FEFECE\n    ArrowColor #A80036\n    BorderColor #A80036\n}\n\nclass NhomSanPham {\n    - maNhom : string\n    - tenNhom : string\n    + LayDanhSachSanPham() : List&lt;SanPham&gt;\n}\n\nclass SanPham {\n    - maSP : string\n    - maNhom : string\n    - tenSP : string\n    - nhaSanXuat : string\n    - hinhAnh : string\n    - moTa : string\n    - thongSoKyThuat : string\n    - giaHienHanh : decimal\n    - tinhTrang : string\n    + KiemTraConHang() : bool\n    + CapNhatGia(giaMoi : decimal) : void\n    + GetThongTinChiTiet() : string\n}\n\nclass KhachHang {\n    - maKH : string\n    - hoTen : string\n    - ngaySinh : DateTime\n    - soCMND : string\n    - diaChi : string\n    - soDienThoai : string\n    - tenDangNhap : string\n    - matKhau : string\n    - email : string\n    + KiemTraMatKhau(pass : string) : bool\n    + KiemTraEmailHopLe() : bool\n    + CapNhatThongTin() : bool\n}\n\nclass NguoiNhanHang {\n    - maNguoiNhan : string\n    - hoTen : string\n    - diaChi : string\n    - soDienThoai : string\n    + KiemTraThongTinHopLe() : bool\n}\n\nclass DonDatHang {\n    - maDonHang : string\n    - maKH : string\n    - maNguoiNhan : string\n    - maLoaiPhieu : string\n    - ngayDat : DateTime\n    - tongTienHang : decimal\n    - chiPhiGiaoHang : decimal\n    - tongTriGia : decimal\n    - trangThai : string\n    + TinhTongTienHang() : decimal\n    + TinhTongTriGia() : decimal\n    + ThemChiTiet(item : ChiTietDonHang) : void\n    + CapNhatTrangThai(trangThaiMoi : string) : void\n}\n\nclass ChiTietDonHang {\n    - maDonHang : string\n    - maSP : string\n    - soLuong : int\n    - donGia : decimal\n    - thanhTien : decimal\n    + TinhThanhTien() : decimal\n    + CapNhatSoLuong(soLuongMoi : int) : void\n}\n\nclass LoaiPhieuDatHang {\n    - maLoaiPhieu : string\n    - tenLoaiPhieu : string\n    - donGia : decimal\n    - thoiGianXuLy : string\n    + GetThoiGianDuKien() : string\n    + TinhPhiTheoLoai() : decimal\n}\n\nclass KhuVucGiaoHang {\n    - maKhuVuc : string\n    - tenKhuVuc : string\n    + GetTenKhuVuc() : string\n}\n\nclass PhiGiaoHang {\n    - maPhi : string\n    - maKhuVuc : string\n    - maLoaiPhieu : string\n    - chiPhi : decimal\n    + LayChiPhi(maKV : string, maLoai : string) : decimal\n}\n\nclass ChinhSachMienPhi {\n    - maChinhSach : string\n    - maLoaiPhieu : string\n    - giaTriToiThieu : decimal\n    - hinhThucMienPhi : string\n    + KiemTraDuDieuKien(tongTien : decimal) : bool\n}\n\nclass LoaiTheTinDung {\n    - maLoaiThe : string\n    - tenLoaiThe : string\n    - doDaiSoThe : int\n    - doDaiCSV : int\n    - mucLePhi : decimal\n    + KiemTraSoTheHopLe(soThe : string) : bool\n    + KiemTraCSVHopLe(csv : string) : bool\n}\n\nclass ThanhToan {\n    - maThanhToan : string\n    - maDonHang : string\n    - maLoaiThe : string\n    - ngayThanhToan : DateTime\n    - soTheAn : string\n    - tenChuThe : string\n    - ngayHetHan : string\n    - soTien : decimal\n    - trangThai : string\n    + TaoGiaoDich() : bool\n    + GhiNhanKetQua(trangThaiMoi : string) : void\n    + AnSoThe(soTheGoc : string) : string\n}\n\n&#39; Quan he giua cac lop va boi so\nNhomSanPham \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham\n\nChiTietDonHang \&quot;0..*\&quot; -- \&quot;1\&quot; SanPham\n\nDonDatHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDonHang\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang\n\nNguoiNhanHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang\n\nLoaiPhieuDatHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang\n\nDonDatHang \&quot;1\&quot; -- \&quot;1\&quot; ThanhToan\n\nLoaiTheTinDung \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan\n\nKhuVucGiaoHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhiGiaoHang\nLoaiPhieuDatHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhiGiaoHang\n\nLoaiPhieuDatHang \&quot;1\&quot; -- \&quot;0..*\&quot; ChinhSachMienPhi\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="S-GSrVVDEN1t2dRpuzBY-1">
